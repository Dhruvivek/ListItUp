generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  twoFactorEnabled Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor[]
  workspaceMembers WorkspaceMember[]
  listMembers      ListMember[]
  guestAccess      Guest[]
  starredLists     Starred[]
  createdItems     Item[]           @relation("ItemCreator")
  itemAssignments  ItemAssignee[]
  platformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentUser")
  grantedPlatformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentGranter")
  revokedPlatformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentRevoker")
  securityEvents SecurityEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// SHARED is a multi-User Workspace; PERSONAL is a User's single-member
// Personal Space, provisioned automatically on first verified sign-in.
// Both share this table so List/Item modeling doesn't fork, but product
// surfaces must never expose a Personal Space as a Workspace (CONTEXT.md).
enum WorkspaceKind {
  SHARED
  PERSONAL
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id          String                @id
  name        String
  kind        WorkspaceKind         @default(SHARED)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lists       List[]
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

model WorkspaceInvitation {
  id          String        @id
  workspaceId String
  email       String
  // Only MEMBER or VIEWER are valid invite-time grants; ADMIN/OWNER are
  // never assigned via invitation (see docs/Specs-Planned domain model spec).
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("workspace_invitation")
}

// A List's role ladder is independent of WorkspaceRole (ADR 0009): a
// ListMember row may only reference a User who already holds a
// Workspace-level membership in that List's Workspace — enforced at the
// application layer in lib/list/, since Guest (below) is the only path to
// List access without one.
enum ListMemberRole {
  LEAD
  MEMBER
  VIEWER
}

enum ListStatus {
  ON_TRACK
  ON_HOLD
  COMPLETED
  DROPPED
}

model List {
  id          String       @id
  workspaceId String
  name        String
  description String?
  status      ListStatus   @default(ON_TRACK)
  isInbox     Boolean      @default(false)
  // Soft-delete: archiving never removes data, so restore is always safe
  // (#26). Null means active.
  archivedAt  DateTime?
  // The List view's "Add Rule" grouping-config control (#29) — a validated
  // string (see lib/list/list-sections.ts's isValidGroupBy) rather than a
  // native enum, since the full set of groupable fields depends on Item's
  // not-yet-built schema (#30); only "SECTION" is legal today.
  groupBy     String       @default("SECTION")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ListMember[]
  guests      Guest[]
  starredBy   Starred[]
  sections    Section[]
  items       Item[]

  @@index([workspaceId])
  @@map("list")
}

model ListMember {
  id        String         @id
  listId    String
  userId    String
  role      ListMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())
  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("list_member")
}

// Read-only access to exactly the List(s) it names, without requiring any
// Workspace-level membership row (unlike ListMember above) — see CONTEXT.md
// Guest and ADR 0009.
model Guest {
  id        String   @id
  listId    String
  userId    String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("guest")
}

// A per-User-per-List flag (CONTEXT.md Starred), not a boolean column on
// List, since it varies by the viewing User.
model Starred {
  id        String   @id
  listId    String
  userId    String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
  @@map("starred")
}

model Section {
  id        String   @id
  listId    String
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  items     Item[]

  @@index([listId])
  @@map("section")
}

enum ItemState {
  TO_DO
  IN_PROGRESS
  BLOCKED
  COMPLETE
  ARCHIVED
}

enum ItemPriority {
  LOW
  NORMAL
  HIGH
}

model Item {
  id        String       @id
  listId    String
  // Self-referencing parent supports arbitrary-depth nesting through one
  // mechanism — no separate Subtask concept (#23, #30).
  parentId  String?
  sectionId String?
  title     String
  dueDate   DateTime?
  state     ItemState    @default(TO_DO)
  priority  ItemPriority @default(NORMAL)
  // Required when state is BLOCKED (enforced at the application layer in
  // lib/item/, not at the schema level).
  blockerReason String?
  // Set once at creation; never reassigned as Assignees change — enforced
  // at the application layer in lib/item/, matching Section/List's
  // established convention for this kind of invariant.
  creatorId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  section   Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent    Item?          @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Item[]         @relation("ItemHierarchy")
  creator   User           @relation("ItemCreator", fields: [creatorId], references: [id])
  assignees ItemAssignee[]

  @@index([listId])
  @@index([sectionId])
  @@index([parentId])
  @@map("item")
}

model ItemAssignee {
  id        String   @id
  itemId    String
  userId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
  @@map("item_assignee")
}

// Better Auth's email-verification tokens are stateless signed JWTs and are
// never persisted, so the per-email resend cooldown needs its own store.
model VerificationEmailThrottle {
  identifier String   @id
  lastSentAt DateTime @default(now())

  @@map("verification_email_throttle")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model PlatformRoleAssignment {
  id              String    @id
  userId          String
  grantedByUserId String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?
  user            User      @relation("PlatformRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser   User      @relation("PlatformRoleAssignmentGranter", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedByUser   User?     @relation("PlatformRoleAssignmentRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("platform_role_assignment")
}

model SecurityEvent {
  id        String   @id
  type      String
  userId    String?
  email     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("security_event")
}

model SecurityNoticeOutbox {
  id             String   @id
  recipient      String
  type           String
  action         String?
  newEmail       String?
  status         String   @default("pending")
  attemptCount   Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  finalFailureAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, finalFailureAt])
  @@map("security_notice_outbox")
}

model SecurityAlertDispatch {
  subject   String   @id
  alertedAt DateTime @default(now())

  @@map("security_alert_dispatch")
}
